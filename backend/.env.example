# Financial OS — environment configuration
# Copy to .env and fill in your keys.

# Required for real Claude API calls in agents.py
# Without this, agents fall back to canned responses (still functional for demo).
ANTHROPIC_API_KEY=

# Optional — real news instead of synthetic
# Get a free key at https://newsdata.io
NEWSDATA_API_KEY=

# Optional — override default DB location
FINANCIAL_OS_DB=./financial_os.db
